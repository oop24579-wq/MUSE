# Copy to .env or export in shell (no dotenv dependency — server reads process.env only;
# `npm start` does not auto-load .env, export vars or use: set -a; source .env; set +a)
PORT=8080
JWT_SECRET=dev-only-change-me-jwt-secret
ADMIN_TOKEN=dev-admin-token-change-me
FIREBASE_AUTH_DEV=1
# --- Production auth (CODE_READINESS): set FIREBASE_PROJECT_ID to enable REAL
# Firebase ID-token verification (RS256 vs Google JWKS). Dev mode above is
# ignored when this is set. AUTH_DEV_MODE=1 is the newer name for dev mode.
# FIREBASE_PROJECT_ID=
# AUTH_DEV_MODE=
# FIREBASE_JWKS_URL=
# --- Rate limiting (defaults shown) ---
# RATE_LIMIT_AUTH_MAX=60
# RATE_LIMIT_AUTH_WINDOW_MS=3600000
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_API_WINDOW_MS=600000
# --- Signed playback URLs (unset = disabled) ---
# PLAYBACK_SIGNING_SECRET=
# PLAYBACK_URL_TTL_SECONDS=3600
WELCOME_COIN_BONUS=30
EPISODE_UNLOCK_COIN_COST=30
DB_PATH=./data/app.db
AD_DAILY_CAP=5
