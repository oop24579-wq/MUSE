# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
pubspec.lock

# System / IDE hidden files
**/.DS_Store
.idea/
.kotlin/
.gradle/
.symlinks/
.temp/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/web/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/docs/
/firebase/
/PRIVATE.md
/reference_images/

# Environment files -- never commit real credentials.
# scripts/generate-drama-images/.env carries live fal.ai / Wiro / R2 keys.
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Editor / tooling backup leftovers
*.bak
*.orig
*.rej
*~

# Local Apple code-signing config -- holds the developer's own Team ID.
# Each developer copies Signing.xcconfig.example and fills in their own.
ios/Flutter/Signing.xcconfig
!ios/Flutter/Signing.xcconfig.example

# Firebase client configs — GitHub secret scanning flagged the API keys in
# these files (repo oop24579-wq/MUSE, commit 4e3c8d7). The files are needed
# locally to build/run the app, so keep them on disk but out of the repo.
# Templates with placeholders live next to them; copy and fill in your own:
#   android/app/google-services.json.example -> google-services.json
#   ios/Runner/GoogleService-Info.plist.example -> GoogleService-Info.plist
# NOTE: the real files are already in git history. Ignoring them now only
# stops FUTURE commits from containing them — rotate the keys in Google
# Cloud Console first, then (optionally) purge history with git filter-repo.
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
ios/GoogleService-Info.plist
