# Android release signing — how to use this file:
#
# 1. Generate your keystore ONCE (keep the .jks file and both passwords
#    somewhere safe — losing them means you can never update the app
#    on Google Play again):
#
#      keytool -genkey -v -keystore herodrama-release.jks -keyalg RSA -keysize 2048 -validity 10000 -alias herodrama
#
# 2. Move the generated herodrama-release.jks into this android/ folder.
#
# 3. Copy this file to a new file named exactly "key.properties" (same
#    folder) and replace the values below with yours.
#
# 4. Build as usual:  flutter build apk --release
#    build.gradle picks key.properties up automatically.
#
# If key.properties does NOT exist, the release build falls back to the
# debug key — fine for installing/testing on your own phone, NOT
# acceptable for Google Play.
#
# key.properties and *.jks are already in .gitignore: they must never
# be committed or uploaded anywhere.

storePassword=YOUR_KEYSTORE_PASSWORD
keyPassword=YOUR_KEY_PASSWORD
keyAlias=herodrama
storeFile=herodrama-release.jks
